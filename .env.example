# Copy to .env and fill in. Never commit real secrets.
DATABASE_URL="postgresql://firehouse:CHANGE_ME@localhost:5432/firehouse_dev"
APP_ORIGIN="http://localhost:3000"
SHELTER_TIMEZONE="America/Chicago"
# >= 32 random chars; used to HMAC client IPs for login throttling
SESSION_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_STRING_32+"
# Breakfast,Lunch,Dinner start times (local, HH:MM)
MEAL_START_TIMES="07:00,11:30,17:00"
# Demo seed passwords (local only; seed refuses defaults in production)
SEED_ADMIN_PASSWORD=""
SEED_USER_PASSWORD=""
